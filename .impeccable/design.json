  "narrative": {
    "northStar": "The Calm Ledger",
    "overview": "The approved balanced mockup A direction uses bright working surfaces, a deep olive navigation rail, and warm chart colors. A quiet, practical layout makes totals, remaining budgets, and transaction entry easy to find. These records describe the implemented static app in `dist/`, including the final CSS overrides.",
    "keyCharacteristics": [
      "Deep olive navigation with a lime primary action.",
      "White, finely bordered panels on a pale canvas.",
      "Clear financial numerals and exact values beside charts.",
      "Compact desktop review and stacked mobile totals."
    ],
    "rules": [
      {
        "name": "The Exact Value Rule",
        "body": "Charts and budget fills accompany readable amounts and labels; color never carries financial meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep financial panels flat; reserve depth for dialogs and toast feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the approved olive, lime, bright-panel direction.",
      "**Do** pair chart and status colors with exact text values.",
      "**Do** retain tabular financial numerals and visible keyboard focus.",
      "**Do** keep mobile totals as separated label/value rows."
    ],
    "donts": [
      "**Don't** replace the warm category mapping with an unrelated palette.",
      "**Don't** add elevation to ordinary ledger panels.",
      "**Don't** make chart color the only way to read an amount or status."
    ]
  }
}
